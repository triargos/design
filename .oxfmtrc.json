{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "jsxSingleQuote": true,
  "semi": true,
  "tabWidth": 2,
  "bracketSameLine": true,
  "bracketSpacing": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "ignorePatterns": ["public/r", "registry.json", "dist", ".alchemy", "pnpm-lock.yaml"]
}
