{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./lint/pavo-plugin.js"],
  "plugins": [],
  "categories": {
    "correctness": "off"
  },
  "rules": {},
  "overrides": [
    {
      "files": ["docs/examples/**/*.tsx"],
